# Helius webhook.
HELIUS_WEBHOOK_SECRET=
# Minimum SOL amount to alert on.
WHALE_THRESHOLD_SOL=500

# --- scripts/register_helius_webhook.py (run locally, one-time) ---
HELIUS_API_KEY=
# Vercel deployment URL + /api/whale-webhook
WEBHOOK_URL=

# --- scripts/price_alert.py (used locally only; GitHub Actions uses repo secrets) ---
PRICE_MOVE_THRESHOLD_PCT=3
